# Copy this file to .env. Keep your real keys private.
AI_PROVIDER=gemini
# Create a key at https://aistudio.google.com/apikey using a Free-tier project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_RESPONSE_FORMAT=json_schema

# Optional alternative: AI_PROVIDER=openrouter and AI_RESPONSE_FORMAT=json_object.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional later upgrade: AI_PROVIDER=openai and choose your paid model.
OPENAI_API_KEY=
OPENAI_MODEL=
FINSIGHT_DB_PATH=data/finsight.sqlite3
